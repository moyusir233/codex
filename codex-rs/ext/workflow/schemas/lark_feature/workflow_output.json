{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LarkFeatureWorkflowOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_run_id",
    "requirement_id",
    "requirement_generation",
    "chat_id",
    "stage_node_ids",
    "stage_thread_ids",
    "requirements_artifact_id",
    "technical_design_document_id",
    "technical_design_revision",
    "exec_plan_document_id",
    "exec_plan_revision",
    "approval_ids",
    "goal_id",
    "validation_artifact_id",
    "acceptance_artifact_id",
    "completion_report_artifact_id",
    "trace_id",
    "observability_delivery_state"
  ],
  "properties": {
    "workflow_run_id": {
      "type": "string"
    },
    "requirement_id": {
      "type": "string"
    },
    "requirement_generation": {
      "type": "integer"
    },
    "chat_id": {
      "type": "string"
    },
    "stage_node_ids": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "stage_thread_ids": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "requirements_artifact_id": {
      "type": "string"
    },
    "technical_design_document_id": {
      "type": "string"
    },
    "technical_design_revision": {
      "type": "string"
    },
    "exec_plan_document_id": {
      "type": "string"
    },
    "exec_plan_revision": {
      "type": "string"
    },
    "approval_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "goal_id": {
      "type": "string"
    },
    "validation_artifact_id": {
      "type": "string"
    },
    "acceptance_artifact_id": {
      "type": "string"
    },
    "completion_report_artifact_id": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "observability_delivery_state": {
      "type": "string"
    }
  }
}
